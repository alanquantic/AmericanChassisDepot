# =============================================
# MAIN DATABASE (Existing - Chassis Catalog)
# =============================================
DATABASE_URL=postgresql://username:password@host/database
PGHOST=your-neon-host.neon.tech
PGUSER=your-username
PGPASSWORD=your-password
PGDATABASE=your-database-name
PGPORT=5432

# =============================================
# MARKETPLACE DATABASE (New - Neon)
# =============================================
MARKETPLACE_DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-silent-wildflower-ahgv2edz-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require
MARKETPLACE_PGHOST=ep-silent-wildflower-ahgv2edz-pooler.c-3.us-east-1.aws.neon.tech
MARKETPLACE_PGUSER=neondb_owner
MARKETPLACE_PGPASSWORD=YOUR_PASSWORD
MARKETPLACE_PGDATABASE=neondb
MARKETPLACE_PROJECT_ID=dark-tooth-89610362

# =============================================
# EMAIL SERVICE (SendGrid) - Required
# =============================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=sales@americanchassisdepot.com
SENDGRID_FROM_NAME=American Chassis Depot

# =============================================
# STRIPE PAYMENTS
# =============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CONNECT_CLIENT_ID=ca_your_stripe_connect_client_id
STRIPE_PLATFORM_FEE_PERCENT=3.5

# =============================================
# AUTHENTICATION (JWT)
# =============================================
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=7d
SESSION_SECRET=your_session_secret_key

# Signed anti-spam form tokens (generate at least 32 random bytes)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FORM_SECRET=replace-with-a-long-random-secret

# =============================================
# CLOUDINARY (Image uploads)
# =============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =============================================
# ODOO INTEGRATION (CRM)
# =============================================
ODOO_URL=https://alpha-tauro.odoo.com
ODOO_API_KEY=your_odoo_api_key
ODOO_USERNAME=alan.avalos@alpha-tauro.com
ODOO_PASSWORD=your_odoo_password
ODOO_COMPANY_ID=1
ODOO_DATABASE=alpha-tauro

# =============================================
# ENVIRONMENT
# =============================================
NODE_ENV=development
VERCEL_URL=your-vercel-url.vercel.app
APP_URL=http://localhost:5000

# =============================================
# MARKETPLACE SETTINGS
# =============================================
MARKETPLACE_ADMIN_EMAIL=sales@americanchassisdepot.com
MARKETPLACE_SUPPORT_EMAIL=sales@americanchassisdepot.com
