{
  "version": 2,
  "name": "american-chassis-depot",
  "builds": [
    {
      "src": "server/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "server/**",
          "shared/**",
          "data/**",
          "package.json",
          "tsconfig.json"
        ]
      }
    },
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "/triaxle_20\\.webp",
      "dest": "/dist/assets/triaxle_20.webp"
    },
    {
      "src": "/triaxle_20_([0-9])\\.webp",
      "dest": "/dist/assets/triaxle_20_$1.webp"
    },
    {
      "src": "/sitemap\\.xml",
      "dest": "server/index.ts"
    },
    {
      "src": "/sitemap-index\\.xml",
      "dest": "server/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "server/index.ts"
    },
    {
      "src": "/(en|es)/(marketplace/listing/[^/]+)$",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|yandex|baiduspider|duckduckbot|twitterbot|facebookexternalhit|facebookbot|linkedinbot|slackbot|whatsapp|telegram|applebot|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|anthropic-ai|perplexitybot|perplexity-user|ccbot|bytespider|amazonbot|cohere-ai|youbot|diffbot).*" }],
      "dest": "server/index.ts"
    },
    {
      "src": "/(en|es)/(marketplace|products|about|contact|new-chassis|used-chassis|brands/.+)$",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|yandex|baiduspider|duckduckbot|twitterbot|facebookexternalhit|facebookbot|linkedinbot|slackbot|whatsapp|telegram|applebot|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|anthropic-ai|perplexitybot|perplexity-user|ccbot|bytespider|amazonbot|cohere-ai|youbot|diffbot).*" }],
      "dest": "server/index.ts"
    },
    {
      "src": "/(en|es)/(container-chassis/.+|chassis-leasing|lease-to-own|fleet-sales|locations/.+)$",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|yandex|baiduspider|duckduckbot|twitterbot|facebookexternalhit|facebookbot|linkedinbot|slackbot|whatsapp|telegram|applebot|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|anthropic-ai|perplexitybot|perplexity-user|ccbot|bytespider|amazonbot|cohere-ai|youbot|diffbot).*" }],
      "dest": "server/index.ts"
    },
    {
      "src": "/(en|es)/?$",
      "has": [{ "type": "header", "key": "user-agent", "value": "(?i).*(googlebot|bingbot|yandex|baiduspider|duckduckbot|twitterbot|facebookexternalhit|facebookbot|linkedinbot|slackbot|whatsapp|telegram|applebot|gptbot|oai-searchbot|chatgpt-user|claudebot|claude-web|anthropic-ai|perplexitybot|perplexity-user|ccbot|bytespider|amazonbot|cohere-ai|youbot|diffbot).*" }],
      "dest": "server/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}